{
  "name": "gather-clone-server",
  "version": "0.1.0",
  "private": true,
  "description": "Servidor do Gather Clone",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"test/unit/**/*.test.ts\" \"test/collision-parity.test.ts\"",
    "test:integration": "node --import tsx --test \"test/integration/**/*.test.ts\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "socket.io-client": "^4.7.5",
    "tsx": "^4.16.0",
    "typescript": "^5.5.4"
  }
}
