# Variáveis de ambiente do servidor (Fase 2, item 3). Copie para `.env` e
# ajuste. O servidor lê de process.env; use um carregador (ex.: `--env-file`
# do Node 20+) ou exporte manualmente.

# Porta.
PORT=3000

# --- Autenticação (Fase 2, item 4) ---
# Token compartilhado por link. Se definido, só quem apresentar o token conecta.
# Vazio/ausente = acesso aberto (dev). Gere um valor forte, ex.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Compartilhe o link:  https://SEU_HOST:5173/?token=SEU_TOKEN
AUTH_TOKEN=

# --- CORS (Fase 2, item 5) ---
# Origens permitidas (separadas por vírgula). Vazio = libera geral (dev).
# Use a origem REAL do cliente, ex.: https://sala.empresa.com:5173
ALLOWED_ORIGINS=

# --- Rate limiting (Fase 2, item 5) ---
# Conexões por IP (segura brute-force de token; generoso p/ NAT compartilhado).
RL_CONN_RATE=5
RL_CONN_BURST=40
# Por socket: move (cliente ~20/s), chat, signal (ICE é chatty).
RL_MOVE_RATE=30
RL_CHAT_RATE=2
RL_SIGNAL_RATE=40

# --- Reconexão preservando identidade (Fase 2, item 7) ---
# Janela de carência (ms) para religar ao estado após uma queda. Curta limita
# a superfície de "sequestro" por sessionId conhecido; longa tolera quedas mais
# demoradas. O estado vive em memória (perde-se se o SERVIDOR reiniciar).
SESSION_GRACE_MS=60000

# Detecção de queda pelo servidor (padrões do socket.io). Baixe para detectar
# desconexões mais rápido, à custa de sensibilidade a hiccups de rede.
# PING_INTERVAL_MS=25000
# PING_TIMEOUT_MS=20000

# --- ICE / TURN (WebRTC) ---
# STUN: separado por vírgula. Sem valor, cai num STUN público em dev.
# Em produção, aponte para o seu coturn (ele também é STUN).
STUN_URLS=stun:turn.seu-dominio.com:3478

# TURN: URLs separadas por vírgula (turn: e/ou turns:).
TURN_URLS=turn:turn.seu-dominio.com:3478,turns:turn.seu-dominio.com:5349

# Segredo compartilhado com o coturn (static-auth-secret no turnserver.conf).
# Sem ele (e sem TURN_URLS), o TURN fica desabilitado — só STUN.
TURN_SECRET=TROQUE_ESTE_SEGREDO_compartilhado_com_o_coturn

# Validade das credenciais efêmeras (segundos). Padrão: 12h.
TURN_TTL_SECONDS=43200

# --- HTTPS / WSS ---
# Fora de localhost, getUserMedia exige HTTPS. Defina os dois para o servidor
# subir em HTTPS (e o Socket.io em WSS). Gere um cert de dev com
# infra/gen-dev-cert.sh, ou use certs reais em produção.
# TLS_CERT=/caminho/para/cert.pem
# TLS_KEY=/caminho/para/key.pem
