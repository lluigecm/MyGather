# Variáveis de ambiente do cliente (Vite). Copie para `.env`.

# URL do servidor Socket.io. Por padrão o cliente deriva da origem da página
# (`<protocolo>//<host>:3000`), o que funciona em localhost e na LAN. Defina
# isto só se o servidor estiver em outro host/porta.
# VITE_SERVER_URL=https://turn.seu-dominio.com:3000
